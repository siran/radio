{
	email {env.ACME_EMAIL}
	# One global ACME policy: DNS-01 via Route 53 for every site below.
	acme_dns route53

	# webdav is not a standard directive; give it an explicit position
	order webdav before file_server
	order rate_limit before webdav

	# Port 1111 keeps serving BOTH schemes (shared links depend on it).
	# TLS handshakes start with 0x16 -> peek and route.
	layer4 {
		:1111 {
			@tls tls
			route @tls {
				proxy 127.0.0.1:8443
			}
			# A live source, on the one port measured to arrive from the internet.
			# 8005 is forwarded at the router and does not come through; 1111 does,
			# proven from a phone on mobile data. This is the plaintext branch, so
			# a source that cannot do TLS still gets in - and one that can still
			# takes the @tls branch above and reaches the site, not the harbor.
			#
			# PUT AND A PATH, never PUT alone. The guestbook and the chat are
			# written with PUT over this same port whenever somebody uses the
			# plaintext site, and matching on the method by itself would post
			# their message into the harbor instead of the folder.
			@source http {
				method PUT SOURCE
				path /live
			}
			route @source {
				proxy 127.0.0.1:8005
			}
			route {
				proxy 127.0.0.1:80
			}
		}

		# Going live from outside the house.
		#
		# The harbor on 8005 speaks the icecast source protocol: an endless body
		# with no HTTP framing. reverse_proxy cannot carry it - measured, a real
		# stream is reset before a note arrives, while an EMPTY put answers 200
		# and looks like it worked. So this is layer 4: raw TCP, forwarded byte
		# for byte, with the protocol left entirely alone.
		#
		# Same first-byte trick as 1111 above. A TLS handshake starts 0x16 and
		# nothing in the icecast protocol does, so one port serves both: a client
		# that can do TLS gets it, one that cannot still connects. Icecast source
		# clients are old software and many have no TLS at all; refusing those
		# would mean refusing the phone in your hand.
		#
		# Not 8005 externally, because liquidsoap already holds that port here.
		# Forward 8006 at the router to 192.168.1.102:8006 and this is reachable;
		# liquidsoap's own firewall rule stays LocalSubnet, so the harbor is
		# never directly exposed - caddy reaches it over loopback, which the
		# firewall does not police.
		:8006 {
			@tls tls
			route @tls {
				tls
				proxy 127.0.0.1:8005
			}
			route {
				proxy 127.0.0.1:8005
			}
		}
	}
}

import speakers.caddy
import admins.caddy
import relays.caddy

# What the door accepts. Stated once, and used by both /host/upload/ and
# /host/relay/ below, because a list written out twice is a list that will
# eventually disagree with itself: add .flac to one of them and notes are either
# accepted and then never played, or refused for something the station decodes
# perfectly well. Neither failure says anything about an extension list.
#
# This is one half of a pair that cannot be collapsed any further. The other
# half is `exts` in radio.liq, and caddy and liquidsoap share no configuration
# format that could hold it, so one statement per program is the floor rather
# than something worth working around. radio.liq is the AUTHORITATIVE half: it
# is what actually decodes the file and decides whether a note reaches the air,
# and this is only the door in front of it. An extension added there and not
# here is refused at the door; added here and not there, it lands in a speaker's
# folder and is never played.
#
# Case is not spelled out the way radio.liq spells it out. Measured on this
# build: caddy's `path` matcher is case-insensitive, so .OPUS and .TXT match
# these lowercase patterns on their own, where liquidsoap compares strings and
# therefore carries an explicit uppercase twin of every entry.
#
# .md and .txt are here for the relay, which takes a spoken line of text down
# the identical path with the speaker's own gain and ducking rather than making
# a second mechanism of it. /host/upload/ narrows them back out.
(note_exts) {
	@noteext path *.webm *.ogg *.oga *.opus *.mp3 *.m4a *.wav *.md *.txt
}

(jellyfin) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8096
}

(radio) {
	# Without this only errors are recorded, and a 401 or 429 is invisible.
	log {
		output file C:/ProgramData/Caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}

	root * {env.RADIO_HOME}

	# Live chat. Same idea as the guestbook: one small file per line.
	# Ephemeral by nature - delete the folder any time.
	handle /chat/* {
		@putmd {
			method PUT
			path *.md
		}
		handle @putmd {
			rate_limit {
				zone chat_writes {
					key {remote_host}
					events 20
					window 1m
				}
			}
			request_body {
				max_size 2KB
			}
			webdav {
				root {env.RADIO_HOME}/chat
				prefix /chat
			}
		}
		# any other PUT (.html, .js, .exe ...) is refused
		@putother method PUT
		handle @putother {
			respond 403
		}
		handle {
			# never let visitor-written bytes execute as markup
			header Content-Type "text/plain; charset=utf-8"
			header X-Content-Type-Options "nosniff"
			header Content-Security-Policy "default-src 'none'; sandbox"
			file_server browse
		}
	}

	# What a show puts on the page beside the music: a few lines of markdown, or
	# a picture. Written by a host, read by the room - the opposite way round
	# from the chat and the guestbook above, which anybody may write.
	#
	# Under /host/ for the reason /host/upload/ is: basic auth credentials are
	# scoped to a URL and everything below it, so a browser challenged for
	# /host/ sends them here without a second prompt, and will not reliably do
	# that across two sibling paths.
	#
	# NO SVG, and that is the whole of why this list is a list rather than
	# "any image". An svg is a document: it may carry script, and a browser
	# asked to render one from this station would run it on this origin. The
	# four raster formats here cannot execute whatever is inside them, and
	# nosniff on the read side stops a renamed file being treated as anything
	# but what its extension claims.
	#
	# max_size TRUNCATES rather than refusing - measured on this build, and the
	# reason /host/upload/ carries the same warning. A picture over the ceiling
	# would be written CUT SHORT with nothing said to the host, so the console
	# stops itself below this figure and explains; this is the backstop, not
	# the guard anybody should hit.
	handle /host/post/* {
		import speakers
		@postput {
			method PUT
			path *.md *.png *.jpg *.jpeg *.webp *.gif
		}
		handle @postput {
			rate_limit {
				zone post_writes {
					key {remote_host}
					events 60
					window 1m
				}
			}
			request_body {
				max_size 4MB
			}
			webdav {
				root {env.RADIO_HOME}/posts
				prefix /host/post
			}
		}
		# a PUT of anything else, and every other method, refused rather than
		# quietly written under a name the read side will not serve
		handle {
			respond 403
		}
	}

	# Reading them: public, like the music. Pictures need their real content
	# type - forcing text/plain the way the chat does would stop them being
	# pictures - so the protection here is that nothing servable from this
	# folder can execute: four raster formats and markdown, no svg, nosniff so
	# a renamed file stays what its extension says, and a sandbox CSP so even
	# a mistake has no origin to act on.
	#
	# The markdown is never rendered by a browser as markup. The listener page
	# fetches it as text and builds DOM nodes from it itself.
	handle /posts/* {
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "default-src 'none'; sandbox"
		file_server browse
	}

	# Private email sidecars: WRITE ONLY. A PUT is accepted so the page can
	# leave an address, but nothing can ever read them back over HTTP.
	# Voice notes. Whatever lands here is played on the air within seconds, so
	# unlike the guestbook it is not open to the world - audio cannot be
	# unsaid. Same credentials as the mixing desk.
	# The host page sits behind the same credential as the upload it makes, so
	# the browser holds it and the page never asks. Same realm means one prompt
	# covers both.
	# The admin page. It cannot change anything by itself - it writes a request
	# file, and a watcher outside the request path does the work. Same shape as
	# the voice notes, different payload.
	handle /admin* {
		import admins
		file_server
	}

	# Request in, result out. Both tiny json files, both short lived.
	# handle_path (not handle) so the /adminapi prefix is stripped before the
	# file server looks on disk - otherwise it hunts for messages/admin/adminapi.
	handle_path /adminapi/* {
		import admins
		@put {
			method PUT
			path *.json
		}
		handle @put {
			rate_limit {
				zone admin_writes {
					key {remote_host}
					events 60
					window 5m
				}
			}
			request_body {
				max_size 4KB
			}
			webdav {
				root {env.RADIO_HOME}/messages/admin
			}
		}
		handle {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			root * {env.RADIO_HOME}/messages/admin
			file_server
		}
	}

	# The page itself is just UI and holds no secrets - the credential is typed
	# into it and sent explicitly with each upload. Guarding the page as well
	# meant two prompts, and mobile chrome would not carry the first one over
	# to the upload, which failed with no way for the speaker to correct it.
	# Uploads live UNDER the page's own path on purpose. Basic auth credentials
	# are scoped to a URL and everything below it, so a browser that has been
	# challenged for /host/ will send them to /host/upload/ without being asked
	# again - which it will not reliably do across two sibling paths.
	handle /host/upload/* {
		import speakers
		@put method PUT
		handle @put {
			import note_exts
			# The two text forms in that list are the relay's, not this route's.
			# A browser recording a note has no reason to post one and this path
			# has never taken them, so they are narrowed back out here rather
			# than widening this route by a side effect of sharing the list.
			@text path *.md *.txt
			handle @text {
				respond 403
			}
			handle @noteext {
				rate_limit {
					zone voice_writes {
						key {remote_host}
						events 150
						window 1m
					}
				}
				# A note is now ONE recording uploaded once, however long it
				# runs, so this has to hold a whole show and not a 1.5s
				# fragment. Same measured trap as settings.json below: max_size
				# TRUNCATES the body, it does not reject it - an oversized note
				# would be written cut short, with nothing said to the speaker.
				# That is why the host page stops itself at 15MB and says why:
				# the ceiling is reached in the browser, where it can be
				# explained, and never here. Measured since, on this build: the
				# request that overruns answers 405 and leaves 16,000,000 bytes
				# on disk, so max_size 16MB is 16 million bytes and not 16 MiB.
				# /host/relay/ refuses on the declared length before webdav
				# opens the file; this route still relies on the page's guard.
				request_body {
					max_size 16MB
				}
				# The folder is whoever authenticated - never what the client
				# says. This is the property /host/relay/ cannot have and the
				# reason it checks the folder instead.
				webdav {
					root {env.RADIO_HOME}/messages/voice/{http.auth.user.id}
					prefix /host/upload
				}
			}
			handle {
				respond 403
			}
		}
		# never readable over http - these are someone's voice
		handle {
			respond 404
		}
	}

	# The relay. eGPT takes a voice note out of a chat and puts it straight into
	# a speaker's folder, so something spoken into a phone reaches the air
	# without anyone opening the host page. One credential covers every speaker,
	# and it is deliberately not any speaker's own: eGPT never learns a human's
	# password and so can never rotate one out from under them. That is what
	# settled this shape over letting eGPT mint speakers of its own - roger and
	# dj sign into the host console with those same passwords, and a relay that
	# re-mints itself to recover would lock a human out of his own console with
	# nothing anywhere saying why.
	#
	# The block above is the opposite of this one, and the difference is the
	# whole design. /host/upload/ files the write under {http.auth.user.id}, so
	# the folder IS whoever authenticated and cannot be aimed anywhere else.
	# This route cannot work that way, because one credential posts on behalf of
	# many people, so the speaker is named in the path instead - and nothing
	# here consults the authenticated user for anything beyond getting through
	# the door. {http.auth.user.id} would read `egpt-relay`, which is not a
	# speaker and is never going to be one; a note filed under it would land in
	# a folder nobody reads. The path is therefore CHECKED rather than trusted,
	# and that check is the file matcher below.
	handle /host/relay/* {
		import relays
		# The shape, and only the shape - a speaker and a filename. What counts
		# as an acceptable filename is the shared list at the top of this file
		# rather than a third copy of it written out here. mint-speaker.ps1
		# reduces a name to [a-z0-9] and lowercases it, so that is exactly what
		# a folder under messages/voice can be called and exactly what is
		# allowed here, which also means no spelling of a dot-segment can reach
		# the file matcher or the webdav under it. The one capture is the
		# speaker, read below as {re.relay.1}.
		@relay {
			method PUT
			path_regexp relay ^/host/relay/([a-z0-9]+)/[A-Za-z0-9._-]+$
		}
		handle @relay {
			import note_exts
			handle @noteext {
				# A body with no declared length cannot be checked before it
				# is written, and letting it through is exactly the
				# truncation described below. 411 says which of the two
				# things is wrong. eGPT sends a file whose size it knows, so
				# this should never fire.
				@nolength not header_regexp Content-Length ^[0-9]+$
				handle @nolength {
					respond 411
				}
				# The measured reason there is a guard here at all rather
				# than max_size on its own. Against max_size 16MB a 17MB PUT
				# answers 405 and leaves 16,000,000 bytes sitting in the
				# speaker's folder: not a 413, and not nothing - a truncated
				# note carrying a current mtime, which the pickup then
				# queues and the station plays. It is the same trap the
				# settings files document, except that here the corrupt file
				# goes on the air instead of being quietly reparsed. So the
				# length is refused before webdav ever opens the file.
				#
				# 16,000,000 and not 16777216: max_size counts in millions,
				# so the 16MB below is 16,000,000 bytes exactly and this has
				# to be the same number, or the gap between the two is
				# precisely the range that gets truncated. Measured at the
				# boundary - 16,000,000 lands whole, 16,000,001 writes
				# nothing at all.
				@toobig expression `int({http.request.header.Content-Length}) > 16000000`
				handle @toobig {
					respond 413
				}
				# Does this speaker exist? The trailing slash is
				# load-bearing: the file matcher reads a path ending in a
				# separator as "must be a directory" and one without as
				# "must not be", so this asks for a FOLDER rather than for
				# anything that happens to carry the name. Verified against
				# this binary - a plain file sitting beside the speaker
				# folders does not satisfy it.
				#
				# This is what the route exists for. An unknown speaker is
				# eGPT's own bug, a name in its table that was never minted,
				# and the operator fixes it in the admin page; a wrong
				# credential is eGPT's to fix. Answered as the same code,
				# every one of them gets diagnosed by the wrong person.
				# Nothing here creates the folder: a typo has to be an error
				# and not a silent new lane nobody meant to make.
				# Taken off the air by an admin, and still a speaker. The
				# credential half of that is a commented line in
				# speakers.caddy, which stops them signing in - but it does
				# NOTHING here, because this route authenticates as the relay
				# and only asks whether the folder exists. Without this a host
				# who had been disabled would still be on the air through
				# WhatsApp, which is the one place the operator cannot see.
				#
				# 403 and not 404: the speaker exists, this is a refusal. The
				# relay treats 404 as "tell the operator to mint them", which
				# is the wrong instruction for somebody who was minted and
				# then switched off on purpose.
				@off file {
					root {env.RADIO_HOME}/messages/voice
					try_files {re.relay.1}/disabled
				}
				handle @off {
					respond 403
				}
				@known file {
					root {env.RADIO_HOME}/messages/voice
					try_files {re.relay.1}/
				}
				handle @known {
					# Only a backstop now, since the guard above refuses
					# anything this could cut. Kept because a cap that
					# lives solely in a matcher is one edit from gone.
					request_body {
						max_size 16MB
					}
					# The folder is the one named in the path and
					# confirmed above - never {http.auth.user.id}, which
					# here is the relay and not a speaker.
					#
					# webdav creates the file where it belongs instead of
					# moving it in, and both halves of that matter. A
					# created file inherits the folder's ACEs - measured
					# on this tree, svc-radio keeps Modify, and svc-radio
					# is what both caddy and liquidsoap run as - where a
					# file moved in carries the ACL of wherever it came
					# from and the note then fails as a codec error,
					# which sends whoever debugs it a long way from the
					# actual problem. It also gets a current mtime, which
					# the pickup requires: anything older than the
					# station's own start is ignored by design.
					#
					# The name is written exactly as it arrived. Nothing
					# here normalises or disambiguates it, so what lands
					# is always what was asked for, and webdav's 201
					# carries no body that could say otherwise. A repeat
					# of a name overwrites, which the ISO timestamps make
					# a non-event.
					webdav {
						root {env.RADIO_HOME}/messages/voice
						prefix /host/relay
					}
				}
				handle {
					respond 404
				}
			}
			# The right shape but an extension the station would never
			# play. Kept apart from the 404 above so that "I sent you
			# something you do not accept" cannot be read as "that person
			# does not exist" - the two are fixed in different places by
			# different people.
			handle {
				respond 415
			}
		}
		# Everything else under /host/relay/: a GET or a DELETE, a path of the
		# wrong depth, or a speaker name no minting could have produced, which
		# is the same answer as a speaker who is not there. Refused rather than
		# left to fall through to the file_server in `handle /host*`, which
		# would serve somebody's voice notes back over http - these are never
		# readable, the same rule /host/upload/ keeps.
		#
		# No rate limit here, and it is a choice rather than an omission. The
		# agreed status table has eGPT stop on a 4xx and retry with backoff on
		# a 5xx; 429 is in neither column, so a limiter firing while a backlog
		# is flushed after a restart would drop notes under a code the other
		# side has no rule for. This is one credential, revoked by deleting one
		# line in relays.caddy, which is the lever that actually fits.
		handle {
			respond 404
		}
	}
	# One small json file per speaker: how loud their own notes play, whether
	# the music dips under them, and their own seven-band EQ, read by
	# liquidsoap from `settings.json` in their folder. The filename is fixed,
	# so this can never
	# become a way to drop an arbitrary file next to someone's voice notes.
	# GET is allowed here where the uploads refuse it - a volume is not private
	# the way a recording is, and the page has to show what it is currently set
	# to. Under /host/ for the same reason as the uploads: the browser already
	# holds that credential and will not ask a second time.
	handle /host/setting/* {
		import speakers
		@settings {
			method GET PUT
			path /host/setting/settings.json
		}
		handle @settings {
			# Measured: max_size TRUNCATES the body, it does not reject it -
			# and webdav then writes the truncated bytes, so an oversized PUT
			# leaves a corrupt settings.json that liquidsoap's json.parse
			# quietly falls back on. Too small a cap here is not an error the
			# speaker can see, it is their volume and ducking silently reset.
			# Seven bands now. The largest object the sliders can produce
			# is 120 bytes, counted over every value each slider can take:
			# the longest gain is 11.5 and the longest band is -8.5, four
			# characters each, and `false` is a character longer than `true`.
			#   {"gain":11.5,"duck":false,"eq":{"f100":-8.5,"f200":-8.5,
			#    "f400":-8.5,"f800":-8.5,"f1600":-8.5,"f3150":-8.5,
			#    "f6300":-8.5}}
			# so leave real headroom rather than sizing it to the day's shape.
			request_body {
				max_size 256B
			}
			# The folder is whoever authenticated - never what the client says.
			webdav {
				root {env.RADIO_HOME}/messages/voice/{http.auth.user.id}
				prefix /host/setting
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	# Named presets, beside settings.json in the same folder and behind the
	# same credential. A preset is BOTH halves of a speaker's sound at once:
	# the streaming settings, which until now lived only in one phone's
	# localStorage and died with a cleared cache, and the gain, duck and seven
	# bands out of settings.json. This is the block above with a different
	# filename - nothing new: fixed name, GET PUT only, folder chosen by the
	# credential and never by the client, everything else 403.
	# Liquidsoap never reads this file; it is the page's own memory. What it
	# writes into settings.json is what reaches the air.
	# The mixing desk, so it survives a restart. Unlike settings.json and
	# presets.json this is NOT per speaker: there is one desk and it belongs to
	# the station, so it lands in config/ beside narrator.json rather than in
	# anybody's folder. Any host may write it, which is the same trust the desk
	# itself already extends - the knobs have always changed the air for everyone
	# the moment they move. This only makes that choice outlive the process.
	# What the narrator has said. The watcher appends to it as each line is
	# spoken; the page reads it to list them, and writes it back with one
	# removed when a host deletes one. Same folder and same shape as the desk,
	# because it is the same kind of thing: station state, not a speaker's.
	# 200 lines at 500 characters is 100KB before quoting, so 256KB.
	handle /narrator/history/* {
		import speakers
		@hist {
			method GET PUT
			path /narrator/history/history.json
		}
		handle @hist {
			request_body {
				max_size 256KB
			}
			webdav {
				root {env.RADIO_HOME}/config
				prefix /narrator/history
			}
		}
		handle {
			respond 404
		}
	}

	# Restart the station, asked for by a host. It reaches a watcher through
	# caddy and never through liquidsoap, which is the whole point: when
	# liquidsoap is the thing that is wedged, anything routed via /control/
	# is as dead as the thing it is meant to revive.
	#
	# Its own folder, deliberately. The admin request folder accepts actions
	# that mint and remove speakers, and pointing hosts at it would hand them
	# those actions for free. Here the folder decides the action and the body
	# cannot argue.
	handle_path /host/restart/* {
		import speakers
		@put {
			method PUT
			path /req/*.json
		}
		handle @put {
			# No limiter here on purpose. The one place a rate limit could live and
			# be changed without editing config and reloading is the watcher, so it
			# lives there and only there - config/limits.json, off by default. A
			# limit in two places is a limit nobody can turn off.
			request_body {
				max_size 1KB
			}
			webdav {
				root {env.RADIO_HOME}/messages/restart
			}
		}
		@res {
			method GET
			path /res/*.json
		}
		handle @res {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			root * {env.RADIO_HOME}/messages/restart
			file_server
		}
		handle {
			respond 404
		}
	}

	# The host's monitor: the music bed without the host in it, straight out of
	# liquidsoap rather than through icecast, so it carries none of icecast's
	# four-second burst.
	#
	# UNDER /host/ on purpose, and rewritten to the mount name on the way
	# through. An <audio> element cannot set an Authorization header, so the
	# only way it authenticates is the credential the browser already cached
	# for this realm - and a browser sends that to URLs at or below the path it
	# was challenged on. At /monitor it would have been challenged again, in a
	# dialog, from an audio tag that cannot show one.
	#
	# flush_interval -1 for the same reason /stream has it: never buffer a
	# response that has no end.
	# The broadcasts themselves. Every show leaves a backup and any named
	# recording sits under named/; both are on disk already and nothing could
	# reach them. This is the link.
	#
	# BEHIND THE SPEAKER CREDENTIAL, not public. These are raw broadcasts - a
	# host's open microphone between tracks, whatever a shared tab was playing -
	# and unlike a card nobody chose what went into them. The posts folder is
	# world-readable because a post is written to be read; a recording is not.
	#
	# handle_path rather than handle: the site root is RADIO_HOME, and these live
	# in RADIO_HOME/recordings, so the prefix comes off and the root moves.
	# browse gives the listing for free, and answers it as JSON to anything that
	# asks with Accept: application/json - which is how the shows page already
	# discovers posts.
	handle_path /host/recordings/* {
		import speakers
		header X-Content-Type-Options "nosniff"
		root * {env.RADIO_HOME}/recordings
		file_server browse
	}

	handle /host/monitor {
		import speakers
		rewrite * /monitor
		reverse_proxy 127.0.0.1:8005 {
			flush_interval -1
		}
	}

	# Going live from the console: the microphone open and audio leaving
	# continuously, rather than a whole note uploaded when it stops. The other
	# half of the monitor above - that one is the station arriving, this is the
	# host leaving.
	#
	# It speaks `webcast`, savonet's own websocket protocol for pushing audio out
	# of a browser, so the wire format has a written definition somebody can look
	# up and anything else that speaks it points here unchanged.
	#
	# It goes to live-bridge.js rather than to liquidsoap, and NOT because
	# liquidsoap cannot take it. This build's harbor speaks webcast perfectly
	# well - measured, from loopback and from 192.168.1.102 alike, a websocket
	# upgrade to 8005/live is answered "101 Switching Protocols" with the
	# webcast subprotocol echoed, and webm/opus frames after it decode.
	#
	# The bridge is here because the webcast hello frame carries the source
	# password, and the source password must not be in a page. That is a
	# permanent property of the protocol meeting a permanent rule of this
	# station, so the bridge is a permanent part of it: it takes the credential
	# caddy has already checked and supplies the station's own. Pointing this
	# route straight at 8005 would work on the first try and would put the
	# harbor password in front of every host with a devtools window.
	#
	# reverse_proxy carries an Upgrade by itself, so there is nothing to
	# configure for it. The port is the bridge's own, on loopback, and the
	# bridge listens nowhere else - it authenticates nobody, and must never be
	# reachable except through this line.
	#
	# UNDER /host/ for the same reason /host/monitor is, and it is not a style
	# choice: a WebSocket opened from a page cannot carry an Authorization
	# header either, so the only credential it has is the one the browser
	# cached for the realm - and a browser sends that to paths at or below where
	# it was challenged. At /onair it would be an anonymous socket into the
	# station's microphone.
	#
	# X-Host-User is who caddy decided this is. The bridge shows it to the next
	# console that tries while somebody is on, because the mount holds one and
	# "403" is not an answer anybody can act on. header_up SETS the header, so
	# a client sending its own is overwritten and not believed.
	# Start and stop a NAMED recording. Going live already leaves a backup, and
	# that is the point of keeping the two apart: the backup is automatic and
	# costs nobody a decision, while a recording is somebody saying "keep this
	# stretch, call it this". A separate route because the things that ask are
	# not all browsers - the console has a button, and whatever is watching the
	# shared tab asks for the same thing with the same credential.
	#
	# Under /host/ for the reason /host/onair is, and it is not a style choice:
	# the credential a page has is the one the browser cached for the realm, and
	# a browser sends that to paths at or below where it was challenged.
	handle /host/onair/rec/* {
		import speakers
		reverse_proxy 127.0.0.1:8007 {
			header_up X-Host-User {http.auth.user.id}
		}
	}

	handle /host/onair {
		import speakers
		reverse_proxy 127.0.0.1:8007 {
			header_up X-Host-User {http.auth.user.id}
		}
	}

	# What the host wants the AI to be, and whether it may post without being
	# asked. One file the console writes and the AI reads - the AI holds a
	# speaker credential already, because it needs one to post at all, so this
	# sits behind the same door as everything else it touches.
	#
	# 8KB where desk.json has 1KB, and the difference is prose. Same measured
	# trap, and it is why the number is generous rather than tight: max_size
	# TRUNCATES and webdav writes the truncated bytes, so a prompt over the cap
	# would be saved cut in half with nothing said - and a model handed
	# instructions that stop mid sentence does something confidently wrong.
	handle /host/ai/* {
		import speakers
		@ai {
			method GET PUT
			path /host/ai/ai.yaml
		}
		handle @ai {
			request_body {
				max_size 8KB
			}
			webdav {
				root {env.RADIO_HOME}/config
				prefix /host/ai
			}
		}
		# one file, one shape, nothing else reachable under this path
		handle {
			respond 404
		}
	}

	# WHAT THE WATCHER SAW, for whatever is reading the tab.
	#
	# File-mediated on purpose, and that is the whole design decision: the
	# station does not know or care WHO reads. The console drops a crop and a
	# little context; something picks it up and writes a reply beside it. eGPT
	# does that today over its speaker credential; a local model on the Pi does
	# it tomorrow with nothing here changing. Swapping the reader is not a
	# migration, it is a different process opening the same folder.
	#
	# 4MB like the post uploads, because it carries a JPEG. The .yaml beside it
	# is tiny, but max_size TRUNCATES rather than refuses - the trap this
	# Caddyfile has hit twice - so one generous cap for both beats a tight cap
	# that silently halves a picture.
	#
	# GET is allowed as well as PUT: the console has to poll for the reply, and
	# the reader has to fetch the crop it was handed.
	handle /host/read/* {
		import speakers
		@read {
			method GET PUT DELETE
			path *.jpg *.yaml
		}
		handle @read {
			rate_limit {
				zone read_writes {
					key {remote_host}
					events 240
					window 1m
				}
			}
			request_body {
				max_size 4MB
			}
			webdav {
				root {env.RADIO_HOME}/read
				prefix /host/read
			}
		}
		# anything else refused rather than written under a name nothing serves
		handle {
			respond 403
		}
	}

	handle /host/desk/* {
		import speakers
		@desk {
			method GET PUT
			path /host/desk/desk.json
		}
		handle @desk {
			# Same measured trap as settings.json and presets.json: max_size
			# TRUNCATES the body and webdav writes the truncated bytes, so too
			# small a cap here is not a visible error - it is a desk.json that
			# liquidsoap cannot parse, falling back to the built-in numbers at
			# the next restart and quietly undoing the tuning this file exists
			# to keep.
			# Counted over every knob at its longest value:
			#   {"mic_gain":4,"voice_gain":12,"hp_freq":300,"comp_thr":-40,
			#    "comp_ratio":20,"comp_gain":24,"duck_to":0.05,"hold":30,
			#    "glide":0.01}
			# = 148 bytes with room for the decimals each can carry. 1KB is
			# nearly seven times that and still far too small to be a way of
			# putting anything else into config/.
			request_body {
				max_size 1KB
			}
			webdav {
				root {env.RADIO_HOME}/config
				prefix /host/desk
			}
		}
		# one file, one shape, nothing else reachable under this path
		handle {
			respond 404
		}
	}

	handle /host/presets/* {
		import speakers
		@presets {
			method GET PUT
			path /host/presets/presets.json
		}
		handle @presets {
			# Same measured trap as settings.json above - max_size TRUNCATES
			# the body and webdav writes the truncated bytes - and here the
			# ending is worse, because one oversized PUT does not corrupt one
			# preset, it makes the whole map unparseable and every saved sound
			# reads back as "no presets".
			# Counted, not guessed. The longest preset the page can produce,
			# taking every control at its longest value:
			#   {"cap":{"cap_seg":"5.9","cap_bitrate":"256000",
			#    "cap_bitmode":"variable","cap_mime":"audio/mp4;codecs=mp4a.40.2",
			#    "cap_srate":"44100","cap_ch":"2","cap_bits":"32",
			#    "cap_lat":"0.01","cap_aec":"off","cap_ns":"off",
			#    "cap_agc":"off","cap_vi":"off"},"voice":{"gain":11.5,
			#    "duck":false,"eq":{"f100":-8.5,"f200":-8.5,"f400":-8.5,
			#    "f800":-8.5,"f1600":-8.5,"f3150":-8.5,"f6300":-8.5}}}
			# = 370 bytes. The page caps a name at 24 characters of
			# [A-Za-z0-9 _-], so a name is 24 bytes and never grows under JSON
			# escaping, and it caps the map at 20 names:
			#   2 + 20*(1 + 24 + 1 + 1 + 370) + 19 = 7961 bytes.
			# The page counts the body and refuses to PUT past 8KB, so it
			# cannot produce a body this route would cut. 32KB is four times
			# that guard - the same headroom narrator.json is given - so a
			# field added to the CAP table later grows every preset without
			# anyone having to remember this number.
			request_body {
				# Recounted when a preset began carrying the narrator's phrases as
				# well as a sound. The ledger those come from is capped at 200
				# rows, and a {t,text} row of a typical announcement is about 80
				# bytes, so one preset can carry 16KB of them and a full twenty
				# can carry 320KB. The page refuses at 512KB; this is the door
				# that has to be wider than the page's own guard, or the page
				# would allow a body that arrives here and gets TRUNCATED - which
				# does not lose one preset, it makes the whole map unparseable.
				max_size 1MB
			}
			# The folder is whoever authenticated - never what the client says.
			webdav {
				root {env.RADIO_HOME}/messages/voice/{http.auth.user.id}
				prefix /host/presets
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	# Saved playlists, beside presets.json in the same folder and behind the
	# same credential. A playlist is a running order the host keeps: tracks
	# chosen now to be sent to the queue later. It is not the queue and it does
	# not play - liquidsoap never reads this file any more than it reads
	# presets.json, and the queue it does play from lives in the process and is
	# reached through /control/. This is the page's own memory, nothing more.
	# Every entry carries the track's title and artist beside its id even though
	# only the id is ever sent to /control/. An id is a digest of the path, so a
	# file that gets moved stops resolving; keeping the words means the list is
	# still readable and can be rebuilt by hand rather than becoming two hundred
	# rows of dead hex. Nothing here tries to repair such a row - it only keeps
	# enough for a person to.
	handle /host/playlists/* {
		import speakers
		@playlists {
			method GET PUT
			path /host/playlists/playlists.json
		}
		handle @playlists {
			# The same measured trap as presets.json above, with the same ending:
			# max_size TRUNCATES the body rather than refusing it and webdav then
			# writes the truncated bytes, so a cap set too low does not lose the
			# last track of the last playlist - it leaves a file no JSON parser
			# will read, and every saved running order is gone at once.
			# Counted, not guessed. One entry is
			#   {"id":"<32 hex>","title":"...","artist":"..."}
			# which is 64 bytes of punctuation and digest before either string.
			# Unlike a preset name, a title or an artist is a tag off a disk rather
			# than something the page controls, so it does grow under encoding: six
			# bytes per character is the worst case, which is a control character
			# written as \u00XX and also covers the four UTF-8 bytes an astral
			# character takes. At 120 characters for each of the two:
			#   64 + 120*6 + 120*6      = 1504 bytes an entry
			# and at 200 tracks a playlist, a name of 24 characters of
			# [A-Za-z0-9 _-] which never grows under escaping, and 20 names:
			#   2 + 200*1504 + 199      = 301001 bytes of tracks
			#   1 + 24 + 1 + 1 + 301001 = 301028 bytes a named playlist
			#   2 + 20*301028 + 19      = 6020581 bytes, just under 6MB.
			# A real file is nothing like that - twenty full playlists of ordinary
			# tags come to about 516KB - but the worst case is what a cap has to
			# clear. The page measures the encoded body, not its length in
			# characters, and refuses to PUT past 6MB, so it cannot produce a body
			# this route would cut. 8MB leaves headroom for a field added to an
			# entry later without anyone having to come back and re-derive this,
			# and is still half of what the voice uploads into this same folder are
			# allowed, so it is not a new way of putting anything large anywhere.
			request_body {
				max_size 8MB
			}
			# The folder is whoever authenticated - never what the client says.
			webdav {
				root {env.RADIO_HOME}/messages/voice/{http.auth.user.id}
				prefix /host/playlists
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	# Sign out. A 401 from a path that asks for no credential of its own is
	# what makes a browser forget the one it cached for /host/ and prompt again.
	# Who you are, straight from the credential you sent. Basic auth gives the
	# browser no way to tell a page its own username, so the server says it.
	handle /whoami {
		import speakers
		respond "{http.auth.user.id}" 200
	}

	# Signing out of basic auth means answering 401 - there is no other lever,
	# the browser holds the credential and only a refusal makes it let go. But
	# a bare 401 lands on the browser's own error page, which looks like the
	# station broke rather than like a door closing behind you. So the refusal
	# carries a page of its own.
	handle /host/logout {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>Signed out - Wild n Loyal Radio</title><style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0e0e10;color:#e8e8ea;font:15px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;text-align:center}h1{font-size:20px;font-weight:600;margin:0 0 6px}a{color:#4ade80}p{color:#8a8a93;font-size:13px;margin:6px 0}</style></head><body><div><h1>Signed out</h1><p>The microphone is closed.</p><p><a href=\"/host/\">sign in again</a> &middot; <a href=\"/\">the station</a></p></div></body></html>" 401
	}
	handle /host* {
		import speakers
		file_server
	}
	# The old name. Hosts have /talk/ bookmarked on their phones, and a dead
	# bookmark mid-show is worse than an untidy config, so it still resolves.
	# 308 and not an ordinary redirect because a page still running the old
	# markup PUTs its slices to /talk/upload/: only 307 and 308 make a browser
	# repeat the method and the body, and a 302 would arrive here as a GET.
	handle_path /talk* {
		redir * /host{uri} 308
	}

	# The narrator's settings - the voice between the tracks, and how it says a
	# name. Folded into /host/, which is where the broadcasting is driven from.
	# ONE shared file, not one per speaker as /host/setting is: this is the
	# station's voice, not anybody's own, and radio control here is
	# collaborative rather than something people compete over.
	handle /narrator/config/* {
		import speakers
		@cfg {
			method GET PUT
			path /narrator/config/narrator.json
		}
		handle @cfg {
			# Same trap as settings.json above, with a worse ending: max_size
			# TRUNCATES the body rather than rejecting it, and webdav writes
			# the truncated bytes. A half-written narrator.json is not a
			# smaller config, it is NO config - liquidsoap's json.parse and the
			# watcher's ConvertFrom-Json both throw on it and fall back to
			# their defaults, so the voice, the speed and every pronunciation
			# are silently lost at once. say_as is a table of names that only
			# ever grows, so this is sized four times over the largest body the
			# page will produce: the page counts the bytes and refuses to PUT
			# past 16KB, which is roughly 300 pronunciations.
			request_body {
				max_size 64KB
			}
			webdav {
				root {env.RADIO_HOME}/config
				prefix /narrator/config
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	# The installed piper voices, so the page offers what is actually on disk
	# rather than a copy of the list that goes stale the day one is added.
	# browse answers in json when the request asks for json, which is what the
	# page does; a human opening it gets the ordinary listing. This is the one
	# place that has to name the piper folder: narrator.json's piper_root can
	# point the RENDERER elsewhere, and then the voice is typed rather than
	# picked, which the page says.
	handle_path /narrator/voices/* {
		import speakers
		root * {env.RADIO_PIPER}/voices
		file_server browse
	}
	# The announcer's own folder, reached without a login. It is a speaker like
	# any other - liquidsoap queues its wavs through the same pickup, at the
	# gain and ducking in its own settings.json - but it is nobody's account,
	# so there is no {http.auth.user.id} to file it under and the root is
	# written out. That fixed root is the whole of the safety here: nothing a
	# client sends chooses the folder.
	handle /narrator/announcer/* {
		import speakers
		# How loud the narrator is, and whether the music dips under it. The
		# same file, the same shape and the same read-modify-write as
		# /host/setting above - this is why the narrator used to sit at 12x
		# over a host who had dialled themselves down to 0.5.
		@settings {
			method GET PUT
			path /narrator/announcer/settings.json
		}
		handle @settings {
			# Measured: max_size TRUNCATES the body, it does not reject it,
			# and webdav writes the truncated bytes - so too small a cap here
			# is not a visible error, it is a settings.json that liquidsoap's
			# json.parse throws on and silently replaces with its defaults,
			# putting the narrator back to full volume mid-show.
			# Worst case, counted over every value the page can produce and
			# every key the file can hold (the seven-band eq, each band at its
			# longest -8.5, gain at its longest 11.5, duck at its longer
			# false):
			#   {"gain":11.5,"duck":false,"eq":{"f100":-8.5,"f200":-8.5,
			#    "f400":-8.5,"f800":-8.5,"f1600":-8.5,"f3150":-8.5,
			#    "f6300":-8.5}}
			# = 120 bytes. The page reads and writes back the WHOLE object, so
			# a key it does not know about rides through a save and grows the
			# body; 1KB is over eight times the worst case and still far too
			# small to be a way to put anything else in that folder.
			request_body {
				max_size 1KB
			}
			webdav {
				root {env.RADIO_HOME}/messages/voice/announcer
				prefix /narrator/announcer
			}
		}
		# Make it say something. There is no new mechanism here: a .txt in this
		# folder IS the interface. narrator-watcher.ps1 polls every 3 s, will
		# not touch a file until its size and mtime were already identical at
		# the previous poll - so one complete PUT is safe - renders it with
		# piper in about 1.7 s and deletes it, and the pickup already in
		# liquidsoap plays the wav over ducked music like any other note.
		# PUT only: what lands here is on the air within seconds, and like the
		# voice uploads it is never readable back.
		@say {
			method PUT
			path *.txt
		}
		handle @say {
			# The page caps the box at 500 characters. A character outside the
			# BMP is 2 of those and 4 bytes; one inside it is 1 and at most 3 -
			# so 3 bytes each is the worst rate, 1500 bytes, plus the newline.
			# 4KB is well over twice that, so maxlength on the box is the only
			# guard needed: it cannot produce a body this route would cut.
			request_body {
				max_size 4KB
			}
			webdav {
				root {env.RADIO_HOME}/messages/voice/announcer
				prefix /narrator/announcer
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	handle /narrator* {
		import speakers
		file_server
	}


	handle /messages/private/* {
		@put {
			method PUT
			path *.txt
		}
		handle @put {
			rate_limit {
				zone private_writes {
					key {remote_host}
					events 5
					window 1m
				}
			}
			request_body {
				max_size 1KB
			}
			webdav {
				root {env.RADIO_HOME}/messages/private
				prefix /messages/private
			}
		}
		handle {
			respond 404
		}
	}

	# Guestbook. Browser PUTs one .md file per comment; Caddy writes it.
	# No application process involved - webdav is a module in this binary.
	handle /messages/* {
		@putmd {
			method PUT
			path *.md
		}
		handle @putmd {
			rate_limit {
				zone message_writes {
					key {remote_host}
					events 5
					window 1m
				}
			}
			request_body {
				max_size 8KB
			}
			webdav {
				root {env.RADIO_HOME}/messages
				prefix /messages
			}
		}
		@putother method PUT
		handle @putother {
			respond 403
		}
		handle {
			header Content-Type "text/plain; charset=utf-8"
			header X-Content-Type-Options "nosniff"
			header Content-Security-Policy "default-src 'none'; sandbox"
			file_server browse
		}
	}

	# Staging copy of the UI. Same stream, same messages, different file.
	# Break it freely - the live page at / is untouched.
	handle /next/* {
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# Source notes live alongside the page - keep them off the internet.
	#
	# Except on the relay, which carries a spoken line of text as a .md into a
	# speaker's folder. This rule has no path prefix of its own, so it reaches
	# every .md on the site including that one, and the note came back 404 while
	# the identical .txt landed 201 - the same code the relay uses for an unknown
	# speaker, which is exactly the confusion the relay was built to avoid.
	# The exceptions are NOT decoration. This matcher has no path prefix, so it
	# reaches every .md on the site, and the two features that store one small
	# .md per line both live under it. Measured just now: /chat/<line>.md
	# answered 404 while the guestbook's /messages/<line>.md answered 200 - and
	# the guestbook was surviving by accident, not by design. handle blocks are
	# ordered by how specific their matcher is rather than by where they sit in
	# this file, and "/messages/*" is a longer string than "*.markdown" while
	# "/chat/*" is shorter. That is the whole reason one worked and one did not.
	# So both are named here, and neither depends on counting characters again.
	@docs {
		path *.md *.markdown
		not path /host/relay/*
		not path /chat/*
		not path /messages/*
		# Posts are markdown too, and this rule 404s every .md on the site. The
		# chat spent ten days unreadable for exactly this reason - the listing
		# worked, every line in it answered 404 - so a new folder of .md files
		# gets its exception written at the same time as the folder.
		not path /posts/*
		# And the path they are WRITTEN to, which is a different string. Measured:
		# a PUT of a .md under /host/post/ answered 404 rather than the credential
		# challenge, because this rule reached it first - so the exception for
		# reading them said nothing about writing them, and a host could not have
		# posted at all.
		not path /host/post/*
	}
	handle @docs {
		respond 404
	}

	# Live audio: never buffer, never compress.
	# Live DJ input, over TLS. The icecast source protocol sends its password
	# in the clear, so it must not cross the internet on its own port - it
	# comes in here instead, where caddy already terminates TLS with a
	# certificate it renews itself.
	handle /live {
		reverse_proxy 127.0.0.1:8005 {
			flush_interval -1
		}
	}
	# Liquidsoap's own mixing desk - live knobs for the voice chain and the
	# ducking, changeable while on air. It has no authentication of its own and
	# can silence the station, so it does not go out unprotected.
	handle /interactive* {
		import speakers
		reverse_proxy 127.0.0.1:8005
	}
	# Driving the music from a page: what is playing, skip, play again, repeat,
	# music on/off, pause. Liquidsoap serves these on the same harbor as the
	# mixing desk above, so this is that block again with a different path.
	# Speakers rather than admins: any host may drive the music, nobody is
	# competing for it.
	handle /control/* {
		import speakers
		reverse_proxy 127.0.0.1:8005
	}
	# The likes ledger. Liquidsoap can only write into live/, which sits under
	# the web root and is therefore served like any other file - and the ledger
	# is a list of paths in D:/Music, which is exactly what /likes/ below takes
	# care not to hand out. Same treatment as the source notes: not on the
	# internet. Not a security boundary, an intentional non-publication.
	handle /live/likes.jsonl {
		respond 404
	}
	# Likes. The /control block again with a different path and, on purpose, NO
	# `import speakers`: anyone listening can like, there is no account to have
	# and nothing here can change what is on the air. Same harbor as above.
	# What happened earlier: what played, what the room voted off, and when
	# somebody went live. Public and READ ONLY - it is the station's own record,
	# and nothing outside liquidsoap ever writes it.
	#
	# No rate limit, unlike its neighbours below. Those meter because a POST
	# appends a line to a file; this is a GET of a list the station already holds
	# in memory, capped at sixty, and metering it would only punish a page that
	# reloads.
	handle /earlier {
		reverse_proxy 127.0.0.1:8005
	}

	handle /likes/* {
		# A POST appends a line to a file, so it gets the same metering as
		# every other public write. It has to be inside an explicit `route`:
		# the global `order` puts rate_limit after reverse_proxy, and
		# reverse_proxy is terminal, so only written order actually runs it.
		route {
			rate_limit {
				zone like_writes {
					key {remote_host}
					events 60
					window 1m
				}
			}
			reverse_proxy 127.0.0.1:8005
		}
	}
	# The skip tug of war. That block again with a different path, public for
	# the same reason - there is no account to have - and separate from it
	# because of the one line above that stops being true here: this CAN change
	# what is on the air.
	#
	# It is safe with no credential because of a property of the mechanism
	# rather than a property of the network. There is one counter per track, it
	# runs 0 to 12, a skip click adds one and a keep click takes one away, and
	# the most a stranger can do is push it up while anybody at all pushes it
	# back down. There is no percentage and no quorum in it, and so nothing that
	# turns two listeners into one person with a casting vote. The host's own
	# skip is elsewhere, under /control/, behind the speaker credential, and
	# unaffected.
	#
	# Metered like every other public write. This is the SERVER half of what
	# stops a script running the counter to twelve in a second - the page keeps
	# a minimum gap between its own clicks, and that is the half a script simply
	# would not run. Sixty a minute is still far more than any human clicking,
	# and it is a bound on the RATE and never on the total: there is no vote
	# budget here, on purpose.
	handle /tug/* {
		route {
			rate_limit {
				zone tug_pulls {
					key {remote_host}
					events 60
					window 1m
				}
			}
			reverse_proxy 127.0.0.1:8005
		}
	}
	handle /stream* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	handle /status-json.xsl* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		# the page is edited live - never let a browser cache it
		header Cache-Control "no-cache, must-revalidate"
		encode zstd gzip
		file_server
	}
}

# --- plaintext on :80 (deliberately not redirected) ---
http://music.wildnloyal.org {
	import jellyfin
}
http://radio.wildnloyal.org {
	import radio
}

# --- HTTPS on :443, bare hostnames ---
music.wildnloyal.org {
	import jellyfin
}
radio.wildnloyal.org {
	import radio
}

# --- loopback HTTPS, fed by the :1111 multiplexer ---
music.wildnloyal.org:8443 {
	bind 127.0.0.1
	import jellyfin
}
radio.wildnloyal.org:8443 {
	bind 127.0.0.1
	import radio
}
