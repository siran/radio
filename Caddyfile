{
	email {env.ACME_EMAIL}
	# One global ACME policy: DNS-01 via Route 53 for every site below.
	acme_dns route53

	# webdav is not a standard directive; give it an explicit position
	order webdav before file_server
	order rate_limit before webdav

	# Port 1111 keeps serving BOTH schemes (shared links depend on it).
	# TLS handshakes start with 0x16 -> peek and route.
	layer4 {
		:1111 {
			@tls tls
			route @tls {
				proxy 127.0.0.1:8443
			}
			route {
				proxy 127.0.0.1:80
			}
		}
	}
}

import speakers.caddy
import admins.caddy

(jellyfin) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8096
}

(radio) {
	# Without this only errors are recorded, and a 401 or 429 is invisible.
	log {
		output file C:/ProgramData/Caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}

	root * C:/Users/an/src/radio

	# Live chat. Same idea as the guestbook: one small file per line.
	# Ephemeral by nature - delete the folder any time.
	handle /chat/* {
		@putmd {
			method PUT
			path *.md
		}
		handle @putmd {
			rate_limit {
				zone chat_writes {
					key {remote_host}
					events 20
					window 1m
				}
			}
			request_body {
				max_size 2KB
			}
			webdav {
				root C:/Users/an/src/radio/chat
				prefix /chat
			}
		}
		# any other PUT (.html, .js, .exe ...) is refused
		@putother method PUT
		handle @putother {
			respond 403
		}
		handle {
			# never let visitor-written bytes execute as markup
			header Content-Type "text/plain; charset=utf-8"
			header X-Content-Type-Options "nosniff"
			header Content-Security-Policy "default-src 'none'; sandbox"
			file_server browse
		}
	}

	# Private email sidecars: WRITE ONLY. A PUT is accepted so the page can
	# leave an address, but nothing can ever read them back over HTTP.
	# Voice notes. Whatever lands here is played on the air within seconds, so
	# unlike the guestbook it is not open to the world - audio cannot be
	# unsaid. Same credentials as the mixing desk.
	# The host page sits behind the same credential as the upload it makes, so
	# the browser holds it and the page never asks. Same realm means one prompt
	# covers both.
	# The admin page. It cannot change anything by itself - it writes a request
	# file, and a watcher outside the request path does the work. Same shape as
	# the voice notes, different payload.
	handle /admin* {
		import admins
		file_server
	}

	# Request in, result out. Both tiny json files, both short lived.
	# handle_path (not handle) so the /adminapi prefix is stripped before the
	# file server looks on disk - otherwise it hunts for messages/admin/adminapi.
	handle_path /adminapi/* {
		import admins
		@put {
			method PUT
			path *.json
		}
		handle @put {
			rate_limit {
				zone admin_writes {
					key {remote_host}
					events 60
					window 5m
				}
			}
			request_body {
				max_size 4KB
			}
			webdav {
				root C:/Users/an/src/radio/messages/admin
			}
		}
		handle {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			root * C:/Users/an/src/radio/messages/admin
			file_server
		}
	}

	# The page itself is just UI and holds no secrets - the credential is typed
	# into it and sent explicitly with each upload. Guarding the page as well
	# meant two prompts, and mobile chrome would not carry the first one over
	# to the upload, which failed with no way for the speaker to correct it.
	# Uploads live UNDER the page's own path on purpose. Basic auth credentials
	# are scoped to a URL and everything below it, so a browser that has been
	# challenged for /host/ will send them to /host/upload/ without being asked
	# again - which it will not reliably do across two sibling paths.
	handle /host/upload/* {
		import speakers
		@putaudio {
			method PUT
			path *.webm *.ogg *.oga *.opus *.mp3 *.m4a *.wav
		}
		handle @putaudio {
			rate_limit {
				zone voice_writes {
					key {remote_host}
					events 150
					window 1m
				}
			}
			# A note is now ONE recording uploaded once, however long it runs,
			# so this has to hold a whole show and not a 1.5s fragment. Same
			# measured trap as settings.json below: max_size TRUNCATES the
			# body, it does not reject it - an oversized note would be written
			# cut short, with nothing said to the speaker. That is why the host
			# page stops itself at 15MB and says why: the ceiling is reached in
			# the browser, where it can be explained, and never here.
			request_body {
				max_size 16MB
			}
			# The folder is whoever authenticated - never what the client says.
			webdav {
				root C:/Users/an/src/radio/messages/voice/{http.auth.user.id}
				prefix /host/upload
			}
		}
		@putother method PUT
		handle @putother {
			respond 403
		}
		# never readable over http - these are someone's voice
		handle {
			respond 404
		}
	}
	# One small json file per speaker: how loud their own notes play, whether
	# the music dips under them, and their own seven-band EQ, read by
	# liquidsoap from `settings.json` in their folder. The filename is fixed,
	# so this can never
	# become a way to drop an arbitrary file next to someone's voice notes.
	# GET is allowed here where the uploads refuse it - a volume is not private
	# the way a recording is, and the page has to show what it is currently set
	# to. Under /host/ for the same reason as the uploads: the browser already
	# holds that credential and will not ask a second time.
	handle /host/setting/* {
		import speakers
		@settings {
			method GET PUT
			path /host/setting/settings.json
		}
		handle @settings {
			# Measured: max_size TRUNCATES the body, it does not reject it -
			# and webdav then writes the truncated bytes, so an oversized PUT
			# leaves a corrupt settings.json that liquidsoap's json.parse
			# quietly falls back on. Too small a cap here is not an error the
			# speaker can see, it is their volume and ducking silently reset.
			# Seven bands now. The largest object the sliders can produce
			# is 120 bytes, counted over every value each slider can take:
			# the longest gain is 11.5 and the longest band is -8.5, four
			# characters each, and `false` is a character longer than `true`.
			#   {"gain":11.5,"duck":false,"eq":{"f100":-8.5,"f200":-8.5,
			#    "f400":-8.5,"f800":-8.5,"f1600":-8.5,"f3150":-8.5,
			#    "f6300":-8.5}}
			# so leave real headroom rather than sizing it to the day's shape.
			request_body {
				max_size 256B
			}
			# The folder is whoever authenticated - never what the client says.
			webdav {
				root C:/Users/an/src/radio/messages/voice/{http.auth.user.id}
				prefix /host/setting
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	# Named presets, beside settings.json in the same folder and behind the
	# same credential. A preset is BOTH halves of a speaker's sound at once:
	# the streaming settings, which until now lived only in one phone's
	# localStorage and died with a cleared cache, and the gain, duck and seven
	# bands out of settings.json. This is the block above with a different
	# filename - nothing new: fixed name, GET PUT only, folder chosen by the
	# credential and never by the client, everything else 403.
	# Liquidsoap never reads this file; it is the page's own memory. What it
	# writes into settings.json is what reaches the air.
	# The mixing desk, so it survives a restart. Unlike settings.json and
	# presets.json this is NOT per speaker: there is one desk and it belongs to
	# the station, so it lands in config/ beside narrator.json rather than in
	# anybody's folder. Any host may write it, which is the same trust the desk
	# itself already extends - the knobs have always changed the air for everyone
	# the moment they move. This only makes that choice outlive the process.
	# What the narrator has said. The watcher appends to it as each line is
	# spoken; the page reads it to list them, and writes it back with one
	# removed when a host deletes one. Same folder and same shape as the desk,
	# because it is the same kind of thing: station state, not a speaker's.
	# 200 lines at 500 characters is 100KB before quoting, so 256KB.
	handle /narrator/history/* {
		import speakers
		@hist {
			method GET PUT
			path /narrator/history/history.json
		}
		handle @hist {
			request_body {
				max_size 256KB
			}
			webdav {
				root C:/Users/an/src/radio/config
				prefix /narrator/history
			}
		}
		handle {
			respond 404
		}
	}

	handle /host/desk/* {
		import speakers
		@desk {
			method GET PUT
			path /host/desk/desk.json
		}
		handle @desk {
			# Same measured trap as settings.json and presets.json: max_size
			# TRUNCATES the body and webdav writes the truncated bytes, so too
			# small a cap here is not a visible error - it is a desk.json that
			# liquidsoap cannot parse, falling back to the built-in numbers at
			# the next restart and quietly undoing the tuning this file exists
			# to keep.
			# Counted over every knob at its longest value:
			#   {"mic_gain":4,"voice_gain":12,"hp_freq":300,"comp_thr":-40,
			#    "comp_ratio":20,"comp_gain":24,"duck_to":0.05,"hold":30,
			#    "glide":0.01}
			# = 148 bytes with room for the decimals each can carry. 1KB is
			# nearly seven times that and still far too small to be a way of
			# putting anything else into config/.
			request_body {
				max_size 1KB
			}
			webdav {
				root C:/Users/an/src/radio/config
				prefix /host/desk
			}
		}
		# one file, one shape, nothing else reachable under this path
		handle {
			respond 404
		}
	}

	handle /host/presets/* {
		import speakers
		@presets {
			method GET PUT
			path /host/presets/presets.json
		}
		handle @presets {
			# Same measured trap as settings.json above - max_size TRUNCATES
			# the body and webdav writes the truncated bytes - and here the
			# ending is worse, because one oversized PUT does not corrupt one
			# preset, it makes the whole map unparseable and every saved sound
			# reads back as "no presets".
			# Counted, not guessed. The longest preset the page can produce,
			# taking every control at its longest value:
			#   {"cap":{"cap_seg":"5.9","cap_bitrate":"256000",
			#    "cap_bitmode":"variable","cap_mime":"audio/mp4;codecs=mp4a.40.2",
			#    "cap_srate":"44100","cap_ch":"2","cap_bits":"32",
			#    "cap_lat":"0.01","cap_aec":"off","cap_ns":"off",
			#    "cap_agc":"off","cap_vi":"off"},"voice":{"gain":11.5,
			#    "duck":false,"eq":{"f100":-8.5,"f200":-8.5,"f400":-8.5,
			#    "f800":-8.5,"f1600":-8.5,"f3150":-8.5,"f6300":-8.5}}}
			# = 370 bytes. The page caps a name at 24 characters of
			# [A-Za-z0-9 _-], so a name is 24 bytes and never grows under JSON
			# escaping, and it caps the map at 20 names:
			#   2 + 20*(1 + 24 + 1 + 1 + 370) + 19 = 7961 bytes.
			# The page counts the body and refuses to PUT past 8KB, so it
			# cannot produce a body this route would cut. 32KB is four times
			# that guard - the same headroom narrator.json is given - so a
			# field added to the CAP table later grows every preset without
			# anyone having to remember this number.
			request_body {
				max_size 32KB
			}
			# The folder is whoever authenticated - never what the client says.
			webdav {
				root C:/Users/an/src/radio/messages/voice/{http.auth.user.id}
				prefix /host/presets
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	# Sign out. A 401 from a path that asks for no credential of its own is
	# what makes a browser forget the one it cached for /host/ and prompt again.
	# Who you are, straight from the credential you sent. Basic auth gives the
	# browser no way to tell a page its own username, so the server says it.
	handle /whoami {
		import speakers
		respond "{http.auth.user.id}" 200
	}

	# Signing out of basic auth means answering 401 - there is no other lever,
	# the browser holds the credential and only a refusal makes it let go. But
	# a bare 401 lands on the browser's own error page, which looks like the
	# station broke rather than like a door closing behind you. So the refusal
	# carries a page of its own.
	handle /host/logout {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>Signed out - Wild n Loyal Radio</title><style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0e0e10;color:#e8e8ea;font:15px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,system-ui,sans-serif;text-align:center}h1{font-size:20px;font-weight:600;margin:0 0 6px}a{color:#4ade80}p{color:#8a8a93;font-size:13px;margin:6px 0}</style></head><body><div><h1>Signed out</h1><p>The microphone is closed.</p><p><a href=\"/host/\">sign in again</a> &middot; <a href=\"/\">the station</a></p></div></body></html>" 401
	}
	handle /host* {
		import speakers
		file_server
	}
	# The old name. Hosts have /talk/ bookmarked on their phones, and a dead
	# bookmark mid-show is worse than an untidy config, so it still resolves.
	# 308 and not an ordinary redirect because a page still running the old
	# markup PUTs its slices to /talk/upload/: only 307 and 308 make a browser
	# repeat the method and the body, and a 302 would arrive here as a GET.
	handle_path /talk* {
		redir * /host{uri} 308
	}

	# The narrator's settings - the voice between the tracks, and how it says a
	# name. Folded into /host/, which is where the broadcasting is driven from.
	# ONE shared file, not one per speaker as /host/setting is: this is the
	# station's voice, not anybody's own, and radio control here is
	# collaborative rather than something people compete over.
	handle /narrator/config/* {
		import speakers
		@cfg {
			method GET PUT
			path /narrator/config/narrator.json
		}
		handle @cfg {
			# Same trap as settings.json above, with a worse ending: max_size
			# TRUNCATES the body rather than rejecting it, and webdav writes
			# the truncated bytes. A half-written narrator.json is not a
			# smaller config, it is NO config - liquidsoap's json.parse and the
			# watcher's ConvertFrom-Json both throw on it and fall back to
			# their defaults, so the voice, the speed and every pronunciation
			# are silently lost at once. say_as is a table of names that only
			# ever grows, so this is sized four times over the largest body the
			# page will produce: the page counts the bytes and refuses to PUT
			# past 16KB, which is roughly 300 pronunciations.
			request_body {
				max_size 64KB
			}
			webdav {
				root C:/Users/an/src/radio/config
				prefix /narrator/config
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	# The installed piper voices, so the page offers what is actually on disk
	# rather than a copy of the list that goes stale the day one is added.
	# browse answers in json when the request asks for json, which is what the
	# page does; a human opening it gets the ordinary listing. This is the one
	# place that has to name the piper folder: narrator.json's piper_root can
	# point the RENDERER elsewhere, and then the voice is typed rather than
	# picked, which the page says.
	handle_path /narrator/voices/* {
		import speakers
		root * D:/services/piper/voices
		file_server browse
	}
	# The announcer's own folder, reached without a login. It is a speaker like
	# any other - liquidsoap queues its wavs through the same pickup, at the
	# gain and ducking in its own settings.json - but it is nobody's account,
	# so there is no {http.auth.user.id} to file it under and the root is
	# written out. That fixed root is the whole of the safety here: nothing a
	# client sends chooses the folder.
	handle /narrator/announcer/* {
		import speakers
		# How loud the narrator is, and whether the music dips under it. The
		# same file, the same shape and the same read-modify-write as
		# /host/setting above - this is why the narrator used to sit at 12x
		# over a host who had dialled themselves down to 0.5.
		@settings {
			method GET PUT
			path /narrator/announcer/settings.json
		}
		handle @settings {
			# Measured: max_size TRUNCATES the body, it does not reject it,
			# and webdav writes the truncated bytes - so too small a cap here
			# is not a visible error, it is a settings.json that liquidsoap's
			# json.parse throws on and silently replaces with its defaults,
			# putting the narrator back to full volume mid-show.
			# Worst case, counted over every value the page can produce and
			# every key the file can hold (the seven-band eq, each band at its
			# longest -8.5, gain at its longest 11.5, duck at its longer
			# false):
			#   {"gain":11.5,"duck":false,"eq":{"f100":-8.5,"f200":-8.5,
			#    "f400":-8.5,"f800":-8.5,"f1600":-8.5,"f3150":-8.5,
			#    "f6300":-8.5}}
			# = 120 bytes. The page reads and writes back the WHOLE object, so
			# a key it does not know about rides through a save and grows the
			# body; 1KB is over eight times the worst case and still far too
			# small to be a way to put anything else in that folder.
			request_body {
				max_size 1KB
			}
			webdav {
				root C:/Users/an/src/radio/messages/voice/announcer
				prefix /narrator/announcer
			}
		}
		# Make it say something. There is no new mechanism here: a .txt in this
		# folder IS the interface. narrator-watcher.ps1 polls every 3 s, will
		# not touch a file until its size and mtime were already identical at
		# the previous poll - so one complete PUT is safe - renders it with
		# piper in about 1.7 s and deletes it, and the pickup already in
		# liquidsoap plays the wav over ducked music like any other note.
		# PUT only: what lands here is on the air within seconds, and like the
		# voice uploads it is never readable back.
		@say {
			method PUT
			path *.txt
		}
		handle @say {
			# The page caps the box at 500 characters. A character outside the
			# BMP is 2 of those and 4 bytes; one inside it is 1 and at most 3 -
			# so 3 bytes each is the worst rate, 1500 bytes, plus the newline.
			# 4KB is well over twice that, so maxlength on the box is the only
			# guard needed: it cannot produce a body this route would cut.
			request_body {
				max_size 4KB
			}
			webdav {
				root C:/Users/an/src/radio/messages/voice/announcer
				prefix /narrator/announcer
			}
		}
		# any other name, and any other method, is refused
		handle {
			respond 403
		}
	}
	handle /narrator* {
		import speakers
		file_server
	}


	handle /messages/private/* {
		@put {
			method PUT
			path *.txt
		}
		handle @put {
			rate_limit {
				zone private_writes {
					key {remote_host}
					events 5
					window 1m
				}
			}
			request_body {
				max_size 1KB
			}
			webdav {
				root C:/Users/an/src/radio/messages/private
				prefix /messages/private
			}
		}
		handle {
			respond 404
		}
	}

	# Guestbook. Browser PUTs one .md file per comment; Caddy writes it.
	# No application process involved - webdav is a module in this binary.
	handle /messages/* {
		@putmd {
			method PUT
			path *.md
		}
		handle @putmd {
			rate_limit {
				zone message_writes {
					key {remote_host}
					events 5
					window 1m
				}
			}
			request_body {
				max_size 8KB
			}
			webdav {
				root C:/Users/an/src/radio/messages
				prefix /messages
			}
		}
		@putother method PUT
		handle @putother {
			respond 403
		}
		handle {
			header Content-Type "text/plain; charset=utf-8"
			header X-Content-Type-Options "nosniff"
			header Content-Security-Policy "default-src 'none'; sandbox"
			file_server browse
		}
	}

	# Staging copy of the UI. Same stream, same messages, different file.
	# Break it freely - the live page at / is untouched.
	handle /next/* {
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# Source notes live alongside the page - keep them off the internet.
	@docs path *.md *.markdown
	handle @docs {
		respond 404
	}

	# Live audio: never buffer, never compress.
	# Live DJ input, over TLS. The icecast source protocol sends its password
	# in the clear, so it must not cross the internet on its own port - it
	# comes in here instead, where caddy already terminates TLS with a
	# certificate it renews itself.
	handle /live {
		reverse_proxy 127.0.0.1:8005 {
			flush_interval -1
		}
	}
	# Liquidsoap's own mixing desk - live knobs for the voice chain and the
	# ducking, changeable while on air. It has no authentication of its own and
	# can silence the station, so it does not go out unprotected.
	handle /interactive* {
		import speakers
		reverse_proxy 127.0.0.1:8005
	}
	# Driving the music from a page: what is playing, skip, play again, repeat,
	# music on/off, pause. Liquidsoap serves these on the same harbor as the
	# mixing desk above, so this is that block again with a different path.
	# Speakers rather than admins: any host may drive the music, nobody is
	# competing for it.
	handle /control/* {
		import speakers
		reverse_proxy 127.0.0.1:8005
	}
	# The likes ledger. Liquidsoap can only write into live/, which sits under
	# the web root and is therefore served like any other file - and the ledger
	# is a list of paths in D:/Music, which is exactly what /likes/ below takes
	# care not to hand out. Same treatment as the source notes: not on the
	# internet. Not a security boundary, an intentional non-publication.
	handle /live/likes.jsonl {
		respond 404
	}
	# Likes. The /control block again with a different path and, on purpose, NO
	# `import speakers`: anyone listening can like, there is no account to have
	# and nothing here can change what is on the air. Same harbor as above.
	handle /likes/* {
		# A POST appends a line to a file, so it gets the same metering as
		# every other public write. It has to be inside an explicit `route`:
		# the global `order` puts rate_limit after reverse_proxy, and
		# reverse_proxy is terminal, so only written order actually runs it.
		route {
			rate_limit {
				zone like_writes {
					key {remote_host}
					events 60
					window 1m
				}
			}
			reverse_proxy 127.0.0.1:8005
		}
	}
	handle /stream* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	handle /status-json.xsl* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		# the page is edited live - never let a browser cache it
		header Cache-Control "no-cache, must-revalidate"
		encode zstd gzip
		file_server
	}
}

# --- plaintext on :80 (deliberately not redirected) ---
http://music.wildnloyal.org {
	import jellyfin
}
http://radio.wildnloyal.org {
	import radio
}

# --- HTTPS on :443, bare hostnames ---
music.wildnloyal.org {
	import jellyfin
}
radio.wildnloyal.org {
	import radio
}

# --- loopback HTTPS, fed by the :1111 multiplexer ---
music.wildnloyal.org:8443 {
	bind 127.0.0.1
	import jellyfin
}
radio.wildnloyal.org:8443 {
	bind 127.0.0.1
	import radio
}
