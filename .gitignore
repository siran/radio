# Never commit
CREDENTIALS.md
LOCAL.md
messages/private/
*.secret
*.key
.env
.env.*

# Editor / local tooling
*.code-workspace
.vscode/
mixxx-watchdog.vbs

# Service noise (messages/*.jsonl ARE tracked)
*.log
messages/service.log

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# chat is ephemeral - delete the folder any time
chat/
NOTES.md

# holds the source and admin passwords
icecast.xml

# liquidsoap writes ./cache relative to the working directory
cache/

# voice notes are ephemeral - the folder is tracked, the audio is not
messages/voice/*
!messages/voice/.keep

# admin and restart requests, and the results written back. A result from a
# mint carries a NEW SPEAKER'S PASSWORD in plain text for the ten minutes
# before the watcher bins it, so this folder must never reach the remote.
messages/admin/
messages/restart/

# live station state, written by the desk and the narrator watcher. Not
# source: it is whatever someone last tuned, and it changes hourly.
config/desk.json
config/narrator.json
config/history.json
config/limits.json

# bcrypt hashes for each speaker - safe-ish, but it is a user list
speakers.caddy
admins.caddy
relays.caddy

# guestbook posts - untracked for now, autocommit later
messages/*.md

# the narrator's current line, rewritten every announcement
live/

# scratch, written to be read and thrown away
disposable.md
