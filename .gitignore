# Never commit
CREDENTIALS.md
LOCAL.md
messages/private/
*.secret
*.key
.env
.env.*

# Editor / local tooling
*.code-workspace
.vscode/
mixxx-watchdog.vbs

# Service noise (messages/*.jsonl ARE tracked)
*.log
messages/service.log

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# chat is ephemeral - delete the folder any time
chat/
NOTES.md

# holds the source and admin passwords
icecast.xml

# liquidsoap writes ./cache relative to the working directory
cache/

# voice notes are ephemeral - the folder is tracked, the audio is not
messages/voice/*
!messages/voice/.keep

# admin and restart requests, and the results written back. A result from a
# mint carries a NEW SPEAKER'S PASSWORD in plain text for the ten minutes
# before the watcher bins it, so this folder must never reach the remote.
messages/admin/
messages/restart/

# live station state, written by the desk and the narrator watcher. Not
# source: it is whatever someone last tuned, and it changes hourly.
config/desk.json
config/narrator.json
config/history.json
config/limits.json

# bcrypt hashes for each speaker - safe-ish, but it is a user list
speakers.caddy
admins.caddy
relays.caddy

# guestbook posts - untracked for now, autocommit later
messages/*.md

# the narrator's current line, rewritten every announcement
live/

# Scratch, written to be read and thrown away. `.disposable` anywhere in the
# name is the mark, and it goes BEFORE the real extension so editors still
# highlight the file: LEAK-access.disposable.md is still markdown.
#
# For anything that must not reach the remote but wants to live beside the
# work: host access notes, a memory dump, a credential-adjacent scratch file.
# Ignored by name, so the mark survives being moved between clones.
disposable.md
*.disposable
*.disposable.*

# Broadcast recordings and their tag marks. Tens of megabytes an hour, kept for
# whatever transcribes or clips them later; RADIO_RECORD moves them off C: if
# that drive gets tight again.
recordings/
